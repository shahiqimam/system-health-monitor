NODE_ENV=development

POSTGRES_DB=pulsewatch
POSTGRES_USER=pulsewatch
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=pulsewatch
DATABASE_USER=pulsewatch
DATABASE_PASSWORD=change_me

JWT_SECRET=replace_with_long_random_value
JWT_EXPIRES_IN=1h

API_PORT=3001
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000
SWAGGER_ENABLED=true
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

SCHEDULER_TICK_SECONDS=15
SCHEDULER_ENABLED=true
MAX_CONCURRENT_CHECKS=10
DEFAULT_CHECK_INTERVAL_SECONDS=60
MIN_CHECK_INTERVAL_SECONDS=15
DEFAULT_TIMEOUT_MS=5000
FAILURE_THRESHOLD=3
RECOVERY_THRESHOLD=2
CHECK_RETENTION_DAYS=30

# SSRF: must stay false for any internet-exposed deployment.
ALLOW_PRIVATE_TARGETS=false

# Seed passwords (demo only)
SEED_ADMIN_PASSWORD=AdminPass123!
SEED_OPERATOR_PASSWORD=OperatorPass123!
SEED_VIEWER_PASSWORD=ViewerPass123!
